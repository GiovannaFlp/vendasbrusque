# Copie este arquivo para .env.local e preencha os valores

# Banco de dados (Vercel Postgres)
# Pegue em: Vercel Dashboard -> Storage -> Connect Store -> seu banco
DATABASE_URL="postgresql://user:password@host/database?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth
# Gere um secret em: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="coloque-um-segredo-aleatorio-longo-aqui"
NEXTAUTH_URL="https://seu-site.vercel.app"
